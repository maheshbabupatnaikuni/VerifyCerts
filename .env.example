DJANGO_SECRET_KEY=replace-with-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8000
VERIFY_BASE_URL=http://127.0.0.1:8000/verify

DB_ENGINE=sqlite
POSTGRES_DB=verifycerts
POSTGRES_USER=verifycerts
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

MAX_UPLOAD_SIZE_MB=15
CERTIFICATE_ID_FORMAT={prefix}-{year}-{dept}-{seq:06d}
INSTITUTION_EMAIL_DOMAIN=example.edu

# Optional Ethereum-compatible network
WEB3_PROVIDER_URI=
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=blockchain/contracts/CertificateRegistry.abi.json
ISSUER_PRIVATE_KEY=
ISSUER_WALLET_ADDRESS=
CHAIN_ID=1337
CHAIN_DISPLAY_NAME=Local Ethereum
CHAIN_EXPLORER_TX_BASE=
CHAIN_EXPLORER_ADDRESS_BASE=

# Optional IPFS integration
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs

TESSERACT_CMD=tesseract

CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Console email keeps local runs self-contained
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.edu
CERTIFICATE_EMAIL_FALLBACK=verification@example.edu

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace-with-a-unique-admin-password
SUPER_ADMIN_EMAIL=admin@example.edu
